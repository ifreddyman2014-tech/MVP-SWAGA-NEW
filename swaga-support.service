[Unit]
Description=SWAGA VPN Support Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/MVP-SWAGA-NEW
Environment="PATH=/root/MVP-SWAGA-NEW/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/root/MVP-SWAGA-NEW/.env
ExecStart=/root/MVP-SWAGA-NEW/venv/bin/python support_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
