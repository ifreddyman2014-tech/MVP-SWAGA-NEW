[Unit]
Description=SWAGA VPN Support Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/MVP-SWAGA-NEW
EnvironmentFile=/root/MVP-SWAGA-NEW/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -c 'exec $([ -f /root/MVP-SWAGA-NEW/venv/bin/python3 ] && echo /root/MVP-SWAGA-NEW/venv/bin/python3 || echo python3) /root/MVP-SWAGA-NEW/support_bot.py'
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=swaga-support

[Install]
WantedBy=multi-user.target
