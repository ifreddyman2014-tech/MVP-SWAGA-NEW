# === Telegram Bot ===
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=123456789

# === 3x-ui Panel (API подключение) ===
XUI_HOST=127.0.0.1
XUI_PORT=2055
XUI_WEB_PATH=/your_secret_path/panel
XUI_USERNAME=admin
XUI_PASSWORD=admin
INBOUND_ID=1

# === VPN Connection (параметры для клиентской ссылки) ===
# Публичный IP сервера (или домен). Клиенты подключаются сюда.
VPN_HOST=your.server.ip
VPN_PORT=19571

# === XHTTP Transport ===
VPN_TRANSPORT=xhttp
VPN_PATH=/adv
VPN_CAMOUFLAGE_HOST=yandex.ru
VPN_XHTTP_MODE=packet-up

# === Reality ===
REALITY_PUBLIC_KEY=your_reality_public_key
REALITY_SHORT_ID=your_short_id
REALITY_FINGERPRINT=chrome
REALITY_SNI=web.de
REALITY_SPIDERX=/

# === YooKassa (заглушка) ===
YOOKASSA_ACCOUNT_ID=dummy
YOOKASSA_SECRET_KEY=dummy

# === Служебные ссылки ===
SUPPORT_URL=https://t.me/your_support_bot

# === База и бэкапы ===
DATABASE_PATH=./vpn_bot.db
BACKUP_PATH=./backups
